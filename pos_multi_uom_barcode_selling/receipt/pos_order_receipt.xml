<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20 receipt (rendered on the server and in the POS): print the unit
         a line was sold in under the product name. -->
    <template id="pos_orderline_receipt_information" inherit_id="point_of_sale.pos_orderline_receipt_information">
        <xpath expr="//div[@name='product-name']" position="after">
            <div t-if="line['mub_uom_name']" name="mub-uom" class="text-normal o_mub_uom_receipt">Unit: <t t-out="line['mub_uom_name']"/></div>
        </xpath>
    </template>
</odoo>
