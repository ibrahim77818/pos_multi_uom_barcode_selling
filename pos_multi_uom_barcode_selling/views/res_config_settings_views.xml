<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_multi_uom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.multi.uom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Multi-UoM Barcode Selling" id="pos_multi_uom_barcode_selling_section">
                    <setting id="pos_multi_uom_barcode_selling_setting" help="Sell products in secondary units of measure by scanning their UoM barcodes, and switch the unit of an order line from the POS. Reload open POS sessions after changing this option.">
                        <field name="pos_multi_uom_barcode_selling"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
